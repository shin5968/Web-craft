<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.webcraft</groupId>
  <artifactId>minecraft-smoke</artifactId>
  <version>0.1.0</version>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <teavm.version>0.16.0</teavm.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>local.minecraft</groupId><artifactId>client</artifactId><version>26.3</version>
      <scope>system</scope><systemPath>${project.basedir}/input/client.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId><artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version><scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId><version>${teavm.version}</version>
        <configuration>
          <targetDirectory>${project.basedir}/../web/minecraft-smoke</targetDirectory>
          <targetFileName>classes.wasm</targetFileName>
          <targetType>WEBASSEMBLY_GC</targetType>
          <mainClass>dev.webcraft.MinecraftSmoke</mainClass>
          <optimizationLevel>ADVANCED</optimizationLevel>
          <minifying>false</minifying>
        </configuration>
        <executions>
          <execution>
            <id>compile-wasm-gc</id><phase>prepare-package</phase><goals><goal>compile</goal></goals>
          </execution>
          <execution>
            <id>copy-runtime</id><phase>prepare-package</phase><goals><goal>copy-webassembly-gc-runtime</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
